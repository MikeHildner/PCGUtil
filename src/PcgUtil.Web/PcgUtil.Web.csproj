<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PcgUtil.Core\PcgUtil.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The human version shown in the UI ("v1.3.0"). BUMP THIS ON EVERY PUBLISH — minor for
         a feature, patch for a docs/fix redeploy — so two live builds are never the same
         version. (It read 1.0 for every deploy up to 2026-07-26, when only the date and hash
         moved.) The deploy script reads it and appends the build stamp and git hash as
         InformationalVersion "<AppVersion>+<yyyy.MM.dd.HHmm>+<short-sha>"; dev builds carry
         "+dev". The deploy script refuses to run when v<AppVersion> is already tagged, so a
         forgotten bump fails loudly before anything uploads. -->
    <AppVersion>1.3.0</AppVersion>
    <InformationalVersion>$(AppVersion)+dev</InformationalVersion>
    <!-- Keep InformationalVersion exactly what we set: the SDK would otherwise append its
         own +<commit> suffix and break the three-part parse. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- VS Browser Link / browser-refresh inject scripts into text/html responses; injecting
         into a pre-compressed static asset corrupts the stream (ERR_HTTP2_PROTOCOL_ERROR on
         hardware-testing.html under F5). Localhost gains nothing from gzip anyway; publish
         compression is a separate property and stays on for the live site. -->
    <DisableBuildCompression Condition="'$(Configuration)' == 'Debug'">true</DisableBuildCompression>
  </PropertyGroup>

</Project>
